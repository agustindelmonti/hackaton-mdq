# CRÍTICO DE PRIVACIDAD: nada de local (.env, credenciales) entra a la imagen
# pública. El Dockerfile además tiene una guardia que hace FALLAR el build si
# algo de esto se cuela (defensa en profundidad).
backend/.env
.env
*.env
backend/credenciales.json
data-papasud/credenciales.json

# Ruido de build (el frontend se compila en su propia etapa)
frontend/node_modules/
frontend/dist/
**/__pycache__/
**/*.pyc
.git/
.gitignore
*.md
backend/tests/
data-papasud/versions/
data-papasud/documentos/
