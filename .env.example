# ============================================================================
# PolPilot × Papasud · plantilla de entorno.
#   cp backend/.env.example backend/.env   y completá la key.
# El .env real está gitignoreado: la key NUNCA se sube.
# ============================================================================

# gateway (default de la demo) | anthropic (API directa) | simulado (sin modelo)
LLM_MODE=gateway

# --- AI GATEWAY DE VERCEL (V0) ----------------------------------------------
# Doc: vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# El modelo viaja prefijado por proveedor. Se cambia sin tocar código.
GATEWAY_MODEL=anthropic/claude-sonnet-5

# --- ANTHROPIC DIRECTO (alternativa si el Gateway no responde) --------------
ANTHROPIC_API_KEY=
ANGELA_MODEL=claude-sonnet-4-6

# --- EL "HOY" DEL DATASET ---------------------------------------------------
# El dataset se generó con esta fecha congelada: el backend TIENE que
# levantarse con la misma o los análisis no coinciden con la historia sembrada.
POLPILOT_DEMO_TODAY=2026-08-22
